{
  "name": "vinami-acs-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "pnpm --filter @vinami/web dev",
    "build": "pnpm --filter @vinami/web build",
    "format": "prettier --write \"{apps/web,packages,scripts}/**/*.{ts,tsx,js,mjs,json,css,md}\" \"docs/frontend/**/*.md\" \"*.{json,yaml,yml,md}\"",
    "format:check": "prettier --check \"{apps/web,packages,scripts}/**/*.{ts,tsx,js,mjs,json,css,md}\" \"docs/frontend/**/*.md\" \"*.{json,yaml,yml,md}\"",
    "lint": "eslint apps/web packages scripts",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:architecture": "vitest run tests/frontend/architecture.test.ts",
    "storybook": "pnpm --filter @vinami/web storybook",
    "storybook:build": "pnpm --filter @vinami/web storybook:build",
    "api:snapshot": "node scripts/snapshot-openapi.mjs",
    "api:generate": "openapi-typescript packages/contracts/openapi.json -o packages/contracts/src/generated.ts",
    "api:check": "node scripts/check-openapi.mjs",
    "quality": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm api:check && pnpm test && pnpm storybook:build"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@playwright/test": "1.61.1",
    "@storybook/addon-a11y": "9.1.17",
    "@storybook/nextjs-vite": "9.1.17",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "20.19.27",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@typescript-eslint/eslint-plugin": "8.46.1",
    "@typescript-eslint/parser": "8.46.1",
    "@vitest/coverage-v8": "3.2.4",
    "@next/eslint-plugin-next": "15.5.20",
    "eslint": "9.39.2",
    "eslint-config-next": "15.5.20",
    "eslint-plugin-storybook": "9.1.17",
    "jsdom": "26.1.0",
    "msw": "2.15.0",
    "openapi-typescript": "7.13.0",
    "prettier": "3.9.5",
    "storybook": "9.1.17",
    "typescript": "5.9.3",
    "vite": "6.4.1",
    "vitest": "3.2.4"
  }
}
